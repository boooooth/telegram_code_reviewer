# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# LLM providers (only the one matching AGENT_MODEL_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=

# Model selection (provider-swappable via init_chat_model)
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL_NAME=claude-sonnet-4-5
SUMMARIZER_MODEL_PROVIDER=anthropic
SUMMARIZER_MODEL_NAME=claude-haiku-4-5
JUDGE_MODEL_PROVIDER=anthropic
JUDGE_MODEL_NAME=claude-haiku-4-5

# GitHub (fine-grained PAT, pull_requests: read scope)
GITHUB_TOKEN=

# Langfuse (tracing + LLM-as-judge scoring; leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Paths
DATA_DIR=./data

# Optional tuning (defaults shown; uncomment to override)
# MAX_WORKING_MEMORY_MESSAGES=6
# MAX_PR_FILES=10
# MAX_PR_FILE_BYTES=50000
# MAX_PR_TOTAL_CONTEXT_BYTES=150000
# MAX_PR_DIFF_BYTES=150000